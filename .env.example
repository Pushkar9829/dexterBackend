# Copy to .env and fill in. Variables already set in the real environment override this file.
# Leave a value empty to use the default shown.

# --- Core ---
NODE_ENV=development
PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=advocateflow
# Required in production: 32+ random characters
SESSION_SECRET=
# Comma-separated browser origins allowed to call the API, e.g. http://localhost:5173,https://crm.example.com
CORS_ORIGINS=https://dexterfrontend.vercel.app,http://localhost:5173
# Set to 1 when behind a reverse proxy
TRUST_PROXY=

# --- Sessions and sign-in ---
SESSION_IDLE_MINUTES=60
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_PER_MIN=100
# off hides the one-time code in login responses (always off in production)
DEMO_OTP=
# demo | mail | sms | whatsapp | totp
MFA_CHANNEL=demo
RECOVERY_CODE_DAYS=180
TOTP_ISSUER=Dexter CRM

# --- Files and audit ---
# gridfs, or any other value to keep files inline (legacy)
FILE_STORE=gridfs
MAX_FILE_MB=10
MAX_VIDEO_MB=
AUDIT_ARCHIVE_DIR=./archive
AUDIT_PURGE_ORPHANS=

# --- Outgoing mail ---
# demo (dev default) | smtp | none (production default)
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SMTP_HELO=
SMTP_TIMEOUT_MS=
SMTP_ALLOW_PLAIN=
SMTP_TLS_INSECURE=

# --- Incoming mail ---
# imap | webhook (empty = off)
MAIL_INBOUND=
MAIL_INBOUND_COMPANY=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_MINUTES=5
IMAP_TLS_INSECURE=
MAIL_WEBHOOK_SECRET=

# --- SMS / WhatsApp ---
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=
CHAT_GATEWAY_URL=
CHAT_GATEWAY_TOKEN=
CHAT_TEMPLATE=

# --- ID checks (PAN / Aadhaar / DL) ---
IDCHECK_URL=
IDCHECK_TOKEN=
IDCHECK_PROVIDER=
IDCHECK_TIMEOUT_MS=15000

# --- HRMS ---
# pull | webhook (empty = off)
HRMS_ADAPTER=
HRMS_COMPANY=
HRMS_URL=
HRMS_TOKEN=
HRMS_PULL_MINUTES=60
HRMS_WEBHOOK_SECRET=

# --- Scripts (smoke, uat, demo-data) ---
API_URL=http://127.0.0.1:4000
